<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Insurance policy testing" parallel="classes">
    <listeners>
        <listener class-name="com.policy.listeners.ExtentTestListener"/>
    </listeners>
    <test name="Chrome testcases">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.policy.tests.TC01_VerifyTravelPageNavigation"/>
            <class name="com.policy.tests.TC02_VerifySchengenCountrySelection"/>
            <class name="com.policy.tests.TC03_VerifyValidTravelDate"/>
            <class name="com.policy.tests.TC04_VerifyContactDetails"/>
            <class name="com.policy.tests.TC05_VerifyAddTravellers"/>
            <class name="com.policy.tests.TC06_ExtractAllCuratedPlans"/>
            <class name="com.policy.tests.TC07_ValidateMedicalCoverPriceUpdate"/>
            <class name="com.policy.tests.TC08_ValidateTop3LowestPlans"/>
            <class name="com.policy.tests.TC09_ExpandAdditionalBenefits"/>
            <class name="com.policy.tests.TC10_ValidateDiscountAndNavigateHome"/>
            <class name="com.policy.tests.TC17_NavigateToHealthInsurance"/>
            <class name="com.policy.tests.TC18_ValidateInvalidPincodeWarning"/>
            <class name="com.policy.tests.TC19_ValidateInvalidMobileAndEmailWarnings"/>
            <class name="com.policy.tests.TC20_ValidateMandatoryFieldTests"/>
            <class name="com.policy.tests.TC21_ValidateSuccessfulFormSubmission"/>
        </classes>
    </test>
    <test name="Edge testcases" >
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.policy.tests.TC01_VerifyTravelPageNavigation"/>
            <class name="com.policy.tests.TC02_VerifySchengenCountrySelection"/>
            <class name="com.policy.tests.TC03_VerifyValidTravelDate"/>
            <class name="com.policy.tests.TC04_VerifyContactDetails"/>
            <class name="com.policy.tests.TC05_VerifyAddTravellers"/>
            <class name="com.policy.tests.TC06_ExtractAllCuratedPlans"/>
            <class name="com.policy.tests.TC07_ValidateMedicalCoverPriceUpdate"/>
            <class name="com.policy.tests.TC08_ValidateTop3LowestPlans"/>
            <class name="com.policy.tests.TC09_ExpandAdditionalBenefits"/>
            <class name="com.policy.tests.TC10_ValidateDiscountAndNavigateHome"/>
            <class name="com.policy.tests.TC17_NavigateToHealthInsurance"/>
            <class name="com.policy.tests.TC18_ValidateInvalidPincodeWarning"/>
            <class name="com.policy.tests.TC19_ValidateInvalidMobileAndEmailWarnings"/>
            <class name="com.policy.tests.TC20_ValidateMandatoryFieldTests"/>
            <class name="com.policy.tests.TC21_ValidateSuccessfulFormSubmission"/>
        </classes>
    </test>
</suite>