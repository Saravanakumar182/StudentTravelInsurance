<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Insurance policy testing" parallel="tests">
    <test name="Bike Insurance tests chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.policy.basetest.TC22_navigateToBikeTab"/>
            <class name="com.policy.basetest.TC23_InvalidMobNumber"/>
            <class name="com.policy.basetest.TC24_TermsAndConditionsValidation"/>
            <class name="com.policy.basetest.TC25_Validquotesubmission"/>
            <class name="com.policy.basetest.TC26_QuoteWorkflowSubmission"/>
        </classes>
    </test>
    <test name="Bike Insurance tests edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.policy.basetest.TC22_navigateToBikeTab"/>
            <class name="com.policy.basetest.TC23_InvalidMobNumber"/>
            <class name="com.policy.basetest.TC24_TermsAndConditionsValidation"/>
            <class name="com.policy.basetest.TC25_Validquotesubmission"/>
            <class name="com.policy.basetest.TC26_QuoteWorkflowSubmission"/>


        </classes>
    </test>
</suite>
