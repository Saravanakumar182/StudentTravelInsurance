<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Insurance policy testing" parallel="classes">
    <test name="Chrome Testcases">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.policy.tests.TC11_MotorInsuranceNavTest"/>
            <class name="com.policy.tests.TC12_CarInsuranceDropdownTest"/>
            <class name="com.policy.tests.TC13_VehicleNumberTest"/>
            <class name="com.policy.tests.TC14_MobileNumberTest"/>
            <class name="com.policy.tests.TC15_EmailTest"/>
            <class name="com.policy.tests.TC16_GetQuoteButtonTest"/>
        </classes>
    </test>
    <test name="Edge Testcases" >
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.policy.tests.TC11_MotorInsuranceNavTest"/>
            <class name="com.policy.tests.TC12_CarInsuranceDropdownTest"/>
            <class name="com.policy.tests.TC13_VehicleNumberTest"/>
            <class name="com.policy.tests.TC14_MobileNumberTest"/>
            <class name="com.policy.tests.TC15_EmailTest"/>
            <class name="com.policy.tests.TC16_GetQuoteButtonTest"/>
        </classes>
    </test>
</suite>